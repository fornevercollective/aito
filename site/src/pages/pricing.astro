---
import VersionSwitcher from '../components/VersionSwitcher.astro';
---

<html lang="en">
<head>
	<meta charset="utf-8" />
	<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
	<title>Pricing — aito</title>
	<style>
		body { background:#0a0a0b; color:#e7e7ea; font-family: system-ui, sans-serif; padding: 2rem; max-width: 720px; margin: 0 auto; line-height: 1.65; }
		h1, h2 { color: #ff5b2e; }
		.card { background:#111113; border:1px solid #222; border-radius:12px; padding:1.75rem; margin:1.5rem 0; }
		.price { font-size:2.25rem; font-weight:600; }
		a { color:#ff5b2e; }
	</style>
</head>
<body>
	<VersionSwitcher />
	<h1>Pricing</h1>
	<p><a href={`${import.meta.env.BASE_URL}`}>← Back to editor</a> · <a href={`${import.meta.env.BASE_URL}hub/`}>Hub</a></p>

	<p style="max-width:560px;">aito is currently in active development. The core editor is free to use while we ship the first production releases.</p>

	<div class="card">
		<h2>Personal / Creator</h2>
		<div class="price">Free <span style="font-size:0.9rem; color:#888;">(while in preview)</span></div>
		<ul style="margin:1rem 0; padding-left:1.25rem; color:#ccc;">
			<li>Full editor (desktop + mobile PWA)</li>
			<li>AI prompt (Grok integration)</li>
			<li>Live tethering via local companion</li>
			<li>Film LUTs + custom .cube support</li>
			<li>Masked corrections + brush refinement</li>
			<li>Hatch export (subject / background / full)</li>
			<li>Bake tree history</li>
		</ul>
		<p style="color:#666; font-size:0.9rem;">No credit card required. Install directly from the site.</p>
	</div>

	<div class="card">
		<h2>Studio / Professional</h2>
		<p style="color:#888;">Coming soon — team seats, advanced LUT pipelines, on-set companion features, priority support, and on-device inference options.</p>
		<p>Early studio access: <a href="mailto:hello@fornevercollective.com">hello@fornevercollective.com</a></p>
	</div>

	<p style="margin-top:2rem; font-size:0.9rem; color:#666;">
		We believe powerful tools should be accessible. The personal version will remain generous.
	</p>
</body>
</html>
