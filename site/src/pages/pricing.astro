---
import VersionSwitcher from '../components/VersionSwitcher.astro';
---

<html lang="en">
<head>
	<meta charset="utf-8" />
	<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
	<title>Pricing — aito</title>
	<style>
		body { background:#0a0a0b; color:#e7e7ea; font-family: system-ui, sans-serif; padding: 2rem; max-width: 720px; margin: 0 auto; line-height: 1.65; }
		h1, h2 { color: #ff5b2e; }
		.card { background:#111113; border:1px solid #222; border-radius:12px; padding:1.75rem; margin:1.5rem 0; }
		.price { font-size:2.25rem; font-weight:600; }
		a { color:#ff5b2e; }
	</style>
</head>
<body>
	<VersionSwitcher />
	<h1>Pricing</h1>
	<p><a href={`${import.meta.env.BASE_URL}`}>← Back to editor</a> · <a href={`${import.meta.env.BASE_URL}hub/`}>Hub</a></p>

	<p style="max-width:560px;">aito is currently in active development. The core editor is free to use while we ship the first production releases.</p>

	<div class="card">
		<h2>Personal / Creator</h2>
		<div class="price">Free <span style="font-size:0.9rem; color:#888;">(public preview)</span></div>
		<ul style="margin:1rem 0; padding-left:1.25rem; color:#ccc;">
			<li>Full editor (desktop + installable mobile PWA)</li>
			<li>Real-time Grok AI commands</li>
			<li>Live camera tethering (local companion)</li>
			<li>Film emulation LUTs + custom .cube / Hald CLUT</li>
			<li>AI masking + pressure-sensitive brush</li>
			<li>Subject / Background / Full hatch exports</li>
			<li>Non-destructive bake history</li>
		</ul>
		<p style="color:#666; font-size:0.9rem;">No account or credit card required. Works offline after first load.</p>
	</div>

	<div class="card">
		<h2>Studio / Professional <span style="font-size:0.7rem; background:#222; padding:1px 6px; border-radius:3px;">soon</span></h2>
		<ul style="margin:0.75rem 0; color:#ccc;">
			<li>Team seats + shared projects</li>
			<li>Advanced LUT pipelines + custom LUT packs</li>
			<li>Native on-set companion (macOS/Linux/Windows)</li>
			<li>Priority support + early access to on-device models</li>
			<li>Volume licensing for production houses</li>
		</ul>
		<p>Early studio access: <a href="mailto:hello@fornevercollective.com">hello@fornevercollective.com</a></p>
	</div>

	<p style="margin-top:2rem; font-size:0.9rem; color:#666;">
		We believe powerful tools should be accessible. The personal version will remain generous.
	</p>
</body>
</html>
