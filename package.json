{
  "name": "aito-umbrella",
  "private": true,
  "version": "0.0.1",
  "description": "aito \u2014 editor + spatial live + living-canvas. Umbrella monorepo (was aito_all).",
  "type": "module",
  "workspaces": [
    "site"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:all": "npm run build && cd site && npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "clean": "rm -rf dist site/dist node_modules/.vite .tsbuildinfo tsconfig.tsbuildinfo",
    "mock:server": "python3 server/inference_ws.py",
    "mock:telemetry": "python3 server/mock_ws.py",
    "launch": "bash start.sh",
    "launch:stageforge": "bash Launch-StageForge.command",
    "spatial": "bash spatial/start.sh",
    "spatial:open": "AITO_OPEN_BROWSER=1 bash spatial/start.sh",
    "launch:spatial": "bash Launch-Spatial.command",
    "sync:imagine-presets": "node scripts/sync-imagine-presets.mjs",
    "living-canvas": "npm --prefix apps/living-canvas run dev"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
